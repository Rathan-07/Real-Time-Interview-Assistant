# Copy to backend/.env and fill in. Never commit backend/.env.

# ---- Deepgram (live streaming STT) ----
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ---- Google Gemini (streaming LLM) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Question detection ----
# Milliseconds of transcript-finalized silence before we treat an utterance as complete.
QUESTION_SILENCE_MS=800

# ---- CORS / WebSocket origin allowlist ----
FRONTEND_ORIGIN=http://localhost:5173
