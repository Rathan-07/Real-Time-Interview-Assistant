# Copy to backend/.env and fill in. Never commit backend/.env.

# ---- Deepgram (live streaming STT) ----
DEEPGRAM_API_KEY=
# nova-3 is Deepgram's newest general model; much better on non-American
# English accents than nova-2. Fall back to nova-2 if your tier lacks nova-3.
DEEPGRAM_MODEL=nova-3
# "en" is more accent-tolerant than "en-US". Use "multi" for auto-detect.
DEEPGRAM_LANGUAGE=en

# ---- Google Gemini (streaming LLM) ----
GEMINI_API_KEY=
# Current working default. gemini-flash-latest and gemini-3.8-flash were
# listed but hung on the free-tier key tested; gemini-3.6-flash streams
# cleanly. Verify with: python scripts/check_providers.py
GEMINI_MODEL=gemini-3.6-flash

# ---- Question detection ----
# Milliseconds of transcript-finalized silence before we treat an utterance as complete.
# Milliseconds of trailing silence before Deepgram ends an utterance.
# 800 ms is Deepgram's own default; 1200 ms is more forgiving of natural
# mid-sentence pauses in interview speech ("Explain... Python generators").
QUESTION_SILENCE_MS=1200

# ---- CORS / WebSocket origin allowlist ----
FRONTEND_ORIGIN=http://localhost:5173
